enum SettingsType {
  aboutUs
  contactUs
  privacyPolicy
  termsAndConditions
}

model Settings {
  id        String       @id @default(cuid())
  type      SettingsType @unique
  details   String       @default("")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([type])
}
