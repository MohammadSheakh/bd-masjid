// Source: base/datasource.prisma
// Prisma datasource configuration.
// This file only describes which database Prisma connects to.
// All models are kept in module folders and combined into prisma/schema.prisma by the build script.
datasource db {
  provider = "postgresql" // Change to "mongodb" only if the schema is converted to Mongo ObjectId style.
}


// Source: base/generator.prisma
// Prisma Client generator.
// Run the schema builder first, then run prisma generate against prisma/schema.prisma.
generator client {
  provider = "prisma-client-js"
  // output   = "../../generated/prisma"
}


// Source: shared/attachment.prisma
enum AttachmentType {
  document
  image
  video
  unknown
}

model Attachment {
  id             String         @id @default(cuid())
  attachment     String
  attachmentType AttachmentType
  publicId       String?
  originalName   String?
  size           Int?
  mimeType       String?

  // Polymorphic target: one attachment can point to a mosque, user, report evidence, etc.
  attachedToType String?
  attachedToId   String?

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([attachedToType, attachedToId, isDeleted])
  @@index([attachmentType, isDeleted])
  @@index([createdAt, isDeleted])
}


// Source: user/_enums.prisma
// User module enums

enum UserRole {
  admin
  moderator
  user
}

enum UserAuthProvider {
  local
  google
}

enum DeviceType {
  web
  ios
  android
  desktop
}


// Source: user/user.prisma
model User {
  id                  String           @id @default(cuid())
  name                String
  email               String           @unique
  password            String?
  role                UserRole         @default(user)
  profileImageUrl     String           @default("/uploads/users/user.png")
  phoneNumber         String?
  isEmailVerified     Boolean          @default(false)
  authProvider        UserAuthProvider @default(local)
  failedLoginAttempts Int              @default(0)
  lockUntil           DateTime?
  twoFactorEnabled            Boolean          @default(false)
  twoFactorSecretEncrypted    String?
  twoFactorPendingEncrypted   String?
  twoFactorRecoveryCodeHashes String[]         @default([])

  isDeleted           Boolean          @default(false)
  deletedAt           DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  // Relationships
  devices             UserDevices[]
  createdMosques      Mosque[]         @relation("MosqueCreator")
  verifiedMosques     Mosque[]         @relation("MosqueVerifier")
  attendanceRecords   UserMosqueAttendance[]
  suggestions         MosqueSuggestion[]
  reports             MosqueReport[]
  scheduleUpdates     PrayerSchedule[]
  scheduleHistories   PrayerScheduleHistory[]
  staffRoles          MosqueStaff[]
  roleClaims          MosqueRoleClaim[]
  announcements       MosqueAnnouncement[]
  bookmarks           MosqueBookmark[]
  submittedDonations  MosqueDonationChannel[] @relation("SubmittedDonations")
  verifiedDonations   MosqueDonationChannel[] @relation("VerifiedDonations")
  donationReports     DonationReport[]
  followedMosques     MosqueFollower[]
  notifications       UserNotification[]


  @@index([email, isDeleted])
  @@index([role, isDeleted])
  @@index([createdAt, isDeleted])
}


// Source: user/userDevices.prisma
model UserDevices {
  id              String     @id @default(cuid())

  // 🔗 Many devices can belong to one user.
  userId          String
  user            User       @relation(fields: [userId], references: [id])

  fcmToken        String
  deviceType      DeviceType @default(web)
  deviceName      String?
  deviceOsVersion String?
  appVersion      String?
  lastActive      DateTime   @default(now())
  pushEnabled     Boolean    @default(true)
  isDeleted       Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([userId, isDeleted])
  @@index([fcmToken, isDeleted])
  @@index([deviceType, isDeleted])
  @@index([lastActive, isDeleted])
}


// Source: announcements.module/announcements.prisma
enum AnnouncementCategory {
  GENERAL
  JUMUAH_KHUTBAH
  EMERGENCY_ALERT
  RAMADAN
  JANAZA
  EID
  MAINTENANCE
}

model MosqueAnnouncement {
  id          String                @id @default(cuid())
  mosqueId    String
  mosque      Mosque                @relation(fields: [mosqueId], references: [id], onDelete: Cascade)

  title       String
  content     String
  category    AnnouncementCategory  @default(GENERAL)
  isPinned    Boolean               @default(false)

  // Scheduling and Expiration
  expiresAt   DateTime?

  // Author and Historical Provenance
  authorId    String
  author      User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorRole  String?

  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([mosqueId, isPinned, createdAt])
  @@index([category, createdAt])
  @@index([expiresAt])
}


// Source: attendance.module/attendance.prisma
enum AttendanceStatus {
  REGULAR
  OCCASIONAL
  NONE
}

model UserMosqueAttendance {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  mosqueId  String
  mosque    Mosque           @relation(fields: [mosqueId], references: [id], onDelete: Cascade)

  status    AttendanceStatus @default(NONE)

  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // Invariant: One registered user has at most one attendance record per mosque
  @@unique([userId, mosqueId])
  @@index([mosqueId, status])
  @@index([userId, status])
}


// Source: audit.module/audit.prisma
enum AuditSource {
  ADMIN_API
  SYSTEM
  JOB
  PROVIDER
}

model AuditLog {
  id            String      @id @default(cuid())
  action        String
  entityType    String
  entityId      String
  actorId       String?
  actorRole     String?
  source        AuditSource @default(ADMIN_API)
  previousValue Json?
  newValue      Json?
  metadata      Json?
  createdAt     DateTime    @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([source, createdAt])
  @@index([createdAt])
}


// Source: community.module/community.prisma
enum MosqueStaffRole {
  MOSQUE_ADMIN
  IMAM
  MUAZZIN
  KHATIB
  KHADEM
  COMMITTEE_PRESIDENT
  COMMITTEE_SECRETARY
  COMMITTEE_MEMBER
}

enum RoleClaimStatus {
  OPEN
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model MosqueStaff {
  id            String          @id @default(cuid())
  mosqueId      String
  mosque        Mosque          @relation(fields: [mosqueId], references: [id], onDelete: Cascade)

  userId        String?
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  role          MosqueStaffRole
  name          String
  contactNumber String?
  isVerified    Boolean         @default(false)
  verifiedAt    DateTime?
  verifiedById  String?

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([mosqueId, role])
  @@index([mosqueId, role, isVerified])
  @@index([userId, isVerified])
  @@index([userId])
}

model MosqueRoleClaim {
  id              String          @id @default(cuid())
  mosqueId        String
  mosque          Mosque          @relation(fields: [mosqueId], references: [id], onDelete: Cascade)

  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  role            MosqueStaffRole
  evidence        String
  documentUrl     String?
  status          RoleClaimStatus @default(OPEN)

  reviewedById    String?
  reviewedAt      DateTime?
  resolutionNotes String?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([mosqueId, status])
  @@index([userId, status])
  @@index([userId])
}


enum DonationMethodType {
  BKASH
  NAGAD
  ROCKET
  UPAY
  BANK_TRANSFER
}

enum DonationAccountType {
  MERCHANT
  PERSONAL
  BANK_ACCOUNT
}

model MosqueDonationMethod {
  id            String              @id @default(cuid())
  mosqueId      String
  mosque        Mosque              @relation(fields: [mosqueId], references: [id], onDelete: Cascade)

  methodType    DonationMethodType
  accountType   DonationAccountType @default(MERCHANT)
  accountNumber String
  accountTitle  String?
  bankName      String?
  branchName    String?
  routingNumber String?
  instructions  String?

  isVerified    Boolean             @default(false)
  verifiedById  String?
  verifiedAt    DateTime?

  createdById   String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([mosqueId, isVerified])
}

model MosqueBookmark {
  id        String   @id @default(cuid())
  mosqueId  String
  mosque    Mosque   @relation(fields: [mosqueId], references: [id], onDelete: Cascade)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([mosqueId, userId])
  @@index([userId])
}



// Source: donations.module/donations.prisma
enum DonationChannelType {
  BKASH
  NAGAD
  ROCKET
  UPAY
  BANK_TRANSFER
}

enum DonationChannelAccountType {
  MERCHANT
  PERSONAL
  AGENT
}

enum DonationPurpose {
  GENERAL_FUND
  CONSTRUCTION_EXPANSION
  ORPHAN_MADRASAH
  RAMADAN_IFTAR
  ZAKAT_SADAQAH
  JANAZA_FUND
}

enum DonationChannelStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  FLAGGED
  ARCHIVED
}

model MosqueDonationChannel {
  id                   String                      @id @default(cuid())
  mosqueId             String
  channelType          DonationChannelType
  accountType          DonationChannelAccountType  @default(PERSONAL)
  purpose              DonationPurpose             @default(GENERAL_FUND)
  accountNumber        String                      @db.VarChar(50)
  accountTitle         String                      @db.VarChar(100)
  bankName             String?                     @db.VarChar(100)
  branchName           String?                     @db.VarChar(100)
  routingNumber        String?                     @db.VarChar(50)
  paymentInstructions  String?                     @db.Text
  qrCodeImageUrl       String?                     @db.VarChar(255)
  status               DonationChannelStatus       @default(PENDING_VERIFICATION)
  disputeCount         Int                         @default(0)

  // Governance Provenance
  createdById          String
  verifiedById         String?
  verifiedAt           DateTime?
  rejectionReason      String?                     @db.VarChar(255)

  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  mosque               Mosque                      @relation(fields: [mosqueId], references: [id], onDelete: Cascade)
  createdBy            User                        @relation("SubmittedDonations", fields: [createdById], references: [id])
  verifiedBy           User?                       @relation("VerifiedDonations", fields: [verifiedById], references: [id])
  reports              DonationReport[]

  @@index([mosqueId, status])
  @@index([channelType, status])
}

model DonationReport {
  id           String                @id @default(cuid())
  channelId    String
  reportedById String
  reason       String                @db.VarChar(100)
  description  String                @db.Text
  status       String                @default("OPEN")
  createdAt    DateTime              @default(now())

  channel      MosqueDonationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  reportedBy   User                  @relation(fields: [reportedById], references: [id], onDelete: Cascade)

  @@index([channelId, status])
}


// Source: facilities.module/facilities.prisma
model MosqueFacility {
  id                    String    @id @default(cuid())
  mosqueId              String    @unique
  mosque                Mosque    @relation(fields: [mosqueId], references: [id], onDelete: Cascade)

  // Overall Capacity
  totalCapacity         Int?
  toiletCount           Int?

  // Ablution (Wudu)
  hasSeparateWudu       Boolean?  @default(false)
  wuduCapacity          Int?

  // Women's Facilities
  hasFemalePrayerSpace  Boolean?  @default(false)
  femaleCapacity        Int?

  // Accessibility
  hasWheelchairAccess   Boolean?  @default(false)
  hasRamp               Boolean?  @default(false)

  // Climate Control
  hasAirConditioning    Boolean?  @default(false)
  hasFan                Boolean?  @default(true)

  // Community Amenities
  hasJanazaService      Boolean?  @default(false)
  hasParkingCar         Boolean?  @default(false)
  hasParkingBike        Boolean?  @default(false)
  hasLibraryMaktab      Boolean?  @default(false)

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([hasFemalePrayerSpace, hasWheelchairAccess])
  @@index([hasAirConditioning])
  @@index([totalCapacity])
}


// Source: mosque.module/mosque.prisma
enum MosqueOperationalStatus {
  OPEN
  TEMPORARILY_CLOSED
  PERMANENTLY_CLOSED
  UNDER_CONSTRUCTION
  UNKNOWN
}

enum MosqueVerificationStatus {
  UNVERIFIED
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

model Mosque {
  id                 String                   @id @default(cuid())
  name               String
  latitude           Float
  longitude          Float
  address            String?
  landmark           String?
  city               String?                  @default("Dhaka")
  country            String                   @default("Bangladesh")

  operationalStatus  MosqueOperationalStatus  @default(OPEN)
  verificationStatus MosqueVerificationStatus @default(UNVERIFIED)

  createdById        String?
  creator            User?                    @relation("MosqueCreator", fields: [createdById], references: [id], onDelete: SetNull)

  verifiedById       String?
  verifier           User?                    @relation("MosqueVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt         DateTime?
  verificationNotes  String?

  isDeleted          Boolean                  @default(false)
  deletedAt          DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  // Facilities
  hasWuduArea             Boolean                  @default(true)
  hasSeparateWomenSpace   Boolean                  @default(false)
  hasAirConditioning      Boolean                  @default(false)
  hasParking              Boolean                  @default(false)
  hasWheelchairAccess     Boolean                  @default(false)
  hasJanazaFacility       Boolean                  @default(false)
  capacity                Int?

  // Relations
  facility                MosqueFacility?
  prayerSchedule          PrayerSchedule?
  scheduleHistories       PrayerScheduleHistory[]
  attendances             UserMosqueAttendance[]
  suggestions             MosqueSuggestion[]
  reports                 MosqueReport[]
  staffMembers            MosqueStaff[]
  roleClaims              MosqueRoleClaim[]
  announcements           MosqueAnnouncement[]
  donationMethods         MosqueDonationMethod[]
  donationChannels        MosqueDonationChannel[]
  bookmarks               MosqueBookmark[]
  followers               MosqueFollower[]
  notifications           UserNotification[]

  @@index([latitude, longitude])
  @@index([verificationStatus, operationalStatus, isDeleted])
  @@index([name, isDeleted])
  @@index([createdById])
  @@index([createdAt])
}


// Source: notifications.module/notifications.prisma
enum NotificationType {
  ANNOUNCEMENT
  SCHEDULE_CHANGE
  DONATION_UPDATE
  PRAYER_REMINDER
}

model MosqueFollower {
  id        String   @id @default(cuid())
  mosqueId  String
  mosque    Mosque   @relation(fields: [mosqueId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, mosqueId])
  @@index([userId, createdAt])
  @@index([mosqueId, createdAt])
}

model UserNotification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  mosqueId  String
  mosque    Mosque           @relation(fields: [mosqueId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String           @db.VarChar(150)
  body      String           @db.Text
  entityId  String?          @db.VarChar(100)
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
  @@index([mosqueId, createdAt])
}


// Source: prayer-schedule.module/prayerSchedule.prisma
model PrayerSchedule {
  id            String   @id @default(cuid())
  mosqueId      String   @unique
  mosque        Mosque   @relation(fields: [mosqueId], references: [id], onDelete: Cascade)

  // Prayer start & Jamaat times (24h HH:mm format)
  fajrStart     String?
  fajrJamaat    String?

  sunrise       String?

  zuhrStart     String?
  zuhrJamaat    String?

  asrStart      String?
  asrJamaat     String?

  maghribStart  String?
  maghribJamaat String?

  ishaStart     String?
  ishaJamaat    String?

  jumuahJamaat  String?
  jumuahSecondJamaat String?
  taraweehJamaat String?
  sahriEnd      String?
  iftarStart    String?

  timezone      String   @default("Asia/Dhaka")

  updatedById   String?
  updatedBy     User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([mosqueId])
  @@index([updatedAt])
}

model PrayerScheduleHistory {
  id               String   @id @default(cuid())
  mosqueId         String
  mosque           Mosque   @relation(fields: [mosqueId], references: [id], onDelete: Cascade)

  scheduleSnapshot Json
  changedById      String?
  changedBy        User?    @relation(fields: [changedById], references: [id], onDelete: SetNull)
  reason           String?

  createdAt        DateTime @default(now())

  @@index([mosqueId, createdAt])
}


// Source: settings.module/settings.prisma
