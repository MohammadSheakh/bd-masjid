# =============================================================================
# BD Masjid — Environment Template (.env.example)
# =============================================================================

# PostgreSQL Connection String (Neon PgBouncer Pooler endpoint)
DATABASE_URL=postgresql://neondb_owner:npg_d3JEBqQonbh0@ep-empty-king-b3mrbn98-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Direct PostgreSQL Connection String for Prisma Migrations (Non-pooler direct endpoint)
DIRECT_URL=postgresql://neondb_owner:npg_d3JEBqQonbh0@ep-empty-king-b3mrbn98.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Timezone
TZ=Asia/Dhaka

# Host Bind IP (127.0.0.1 for local isolation / Cloudflare tunnel security)
BACKEND_BIND_IP=127.0.0.1
FRONTEND_BIND_IP=127.0.0.1
REDIS_BIND_IP=127.0.0.1

# Host Exposed Ports
BACKEND_PORT=6733
FRONTEND_PORT=3005
REDIS_PORT=6379

# API Configuration
PORT=6733
API_PREFIX=api/v1
NEXT_PUBLIC_API_URL=http://localhost:6733/api/v1

# Security Secrets (Generate using: openssl rand -hex 32)
JWT_ACCESS_SECRET=your-64-character-jwt-access-secret-hex
JWT_REFRESH_SECRET=your-64-character-jwt-refresh-secret-hex

# Web URLs for CORS
CUSTOMER_WEB_URL=http://localhost:3005
ADMIN_WEB_URL=http://localhost:3001

# Migrations on container startup
RUN_MIGRATIONS=true

# Cloudflare Tunnel (Optional, from Zero Trust Dashboard)
CLOUDFLARE_TUNNEL_TOKEN=
